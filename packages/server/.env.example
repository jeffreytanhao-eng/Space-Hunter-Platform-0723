# 应用配置
APP_PORT=3000
APP_ENV=development

# 数据库配置 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=space_hunter
DB_SYNCHRONIZE=false

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# 腾讯云 COS 配置
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou

# Swagger 配置
SWAGGER_TITLE=太空猎人 API
SWAGGER_DESCRIPTION=太空猎人天文社区平台 API 文档
SWAGGER_VERSION=0.1.0
SWAGGER_ENABLED=true

# 内容审核配置
MODERATION_BLOCK_THRESHOLD=2
MODERATION_SUSPECT_THRESHOLD=1
MODERATION_CASE_SENSITIVE=false

# 短信验证码配置（阿里云 SMS）
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your-sms-access-key-id
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret
SMS_SIGN_NAME=太空猎人
SMS_TEMPLATE_CODE=SMS_XXXXXXXX
SMS_EXPIRE_SECONDS=300
SMS_DAILY_LIMIT=10
