{
  "name": "space-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "太空猎人 - 天文社区平台 Monorepo",
  "workspaces": [
    "packages/server",
    "packages/web",
    "packages/miniapp",
    "packages/shared"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:server": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "dev:miniapp": "npm run dev -w packages/miniapp",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "prettier": "^3.2.0",
    "eslint": "^8.56.0"
  }
}
