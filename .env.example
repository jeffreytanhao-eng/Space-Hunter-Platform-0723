# ==========================================
# 太空猎人 - Docker Compose 环境变量配置
# 复制此文件为 .env 并填入实际值
# ==========================================

# ---------- 应用配置 ----------
APP_PORT=3000
APP_ENV=production

# ---------- 数据库配置 (PostgreSQL) ----------
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-secure-db-password
DB_DATABASE=space_hunter
DB_SYNCHRONIZE=false

# ---------- Redis 配置 ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# ---------- JWT 配置 ----------
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d

# ---------- 腾讯云 COS 配置 ----------
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou
# 本地存储目录（容器内路径，对应 docker-compose volume 挂载）
UPLOAD_LOCAL_DIR=/app/packages/server/uploads

# ---------- Swagger 配置 ----------
SWAGGER_TITLE=太空猎人 API
SWAGGER_DESCRIPTION=太空猎人天文社区平台 API 文档
SWAGGER_VERSION=0.1.0
SWAGGER_ENABLED=false

# ---------- 短信验证码配置 (spacemapper.cn) ----------
SMS_BASE_URL=https://spacemapper.cn
SMS_APP_ID=your-sms-app-id
SMS_APP_KEY=your-sms-app-key
SMS_APP_SECRET=your-sms-app-secret

# ---------- 火山引擎 AI MediaKit 配置（图像画质增强测试） ----------
# API Key 在火山控制台创建：https://console.volcengine.com/imp/ai-mediakit/settings
VOLC_MEDIAKIT_BASE_URL=https://mediakit.cn-beijing.volces.com/api/v1
VOLC_MEDIAKIT_API_KEY=your-volc-mediakit-api-key

# ---------- 火山引擎 veImageX 配置（AIGC 大模型超分） ----------
# 开通 veImageX 服务 + 智能处理计费后，从控制台获取：
#   ServiceId: https://console.volcengine.com/imagex/service_manage/
#   AK/SK:     https://console.volcengine.com/iam/keymanage/
VOLC_IMAGEX_SERVICE_ID=your-imagex-service-id
VOLC_IMAGEX_AK=your-access-key
VOLC_IMAGEX_SK=your-secret-key

# ---------- Next.js 前端配置 ----------
# 注意: NEXT_PUBLIC_API_BASE 需要在 docker-compose.yml 的 build.args 中设置
# 因为 Next.js 在构建时内联 NEXT_PUBLIC_* 变量到客户端 JS
NEXT_PUBLIC_API_BASE=http://backend:3000/api
NEXT_PUBLIC_IMAGE_CDN=https://cdn.example.com

# ---------- FITS Worker 配置 ----------
FITS_WORKER_PORT=8000
