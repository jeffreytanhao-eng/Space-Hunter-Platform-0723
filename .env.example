# ==========================================
# 太空猎人 - Docker Compose 环境变量配置
# 复制此文件为 .env 并填入实际值
# ==========================================

# ---------- 应用配置 ----------
APP_PORT=3000
APP_ENV=production

# ---------- 数据库配置 (PostgreSQL) ----------
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-secure-db-password
DB_DATABASE=space_hunter
DB_SYNCHRONIZE=false

# ---------- Redis 配置 ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# ---------- JWT 配置 ----------
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d

# ---------- 腾讯云 COS 配置 ----------
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-name
COS_REGION=ap-guangzhou

# ---------- Swagger 配置 ----------
SWAGGER_TITLE=太空猎人 API
SWAGGER_DESCRIPTION=太空猎人天文社区平台 API 文档
SWAGGER_VERSION=0.1.0
SWAGGER_ENABLED=false

# ---------- Next.js 前端配置 ----------
# 注意: NEXT_PUBLIC_API_BASE 需要在 docker-compose.yml 的 build.args 中设置
# 因为 Next.js 在构建时内联 NEXT_PUBLIC_* 变量到客户端 JS
NEXT_PUBLIC_API_BASE=http://backend:3000/api
NEXT_PUBLIC_IMAGE_CDN=https://cdn.example.com

# ---------- FITS Worker 配置 ----------
FITS_WORKER_PORT=8000
