# 太空猎人 - Docker 忽略文件
# 排除不需要进入 Docker 镜像的文件，减小构建上下文体积

# 版本控制
.git
.gitignore
.gitattributes

# IDE 和编辑器
.vscode
.idea
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# 构建产物（Docker 内会重新构建）
dist
.next
out
build
.taro

# 测试和覆盖率
coverage
.nyc_output
test
__tests__
*.spec.ts
*.test.ts
*.e2e-spec.ts

# 环境配置（通过 env_file 注入，不打入镜像）
.env
.env.*
!.env.example

# Docker 相关
docker-compose*.yml
Dockerfile*
.dockerignore

# 文档
*.md
docs

# 日志
logs
*.log

# 临时文件
tmp
temp
*.tmp

# 小程序构建产物（不需要在 Docker 中）
packages/miniapp

# Trae 配置
.trae

# ESLint / Prettier
.eslintrc*
.prettierrc*
.prettierignore

# TypeScript 增量编译缓存
*.tsbuildinfo
